---
import type { CollectionEntry } from 'astro:content';
import ProjectBadges from './ProjectBadges.astro';
import ProjectLinks from './ProjectLinks.astro';

type ProjectData = CollectionEntry<'projects'>['data'];

export interface Props {
  title: string;
  type: ProjectData['type'];
  description: string;
  image?: string;
  imageAlt?: string;
  tags?: string[];
  urls?: ProjectData['urls'];
  status?: ProjectData['status'];
  slug: string;
}

const { title, type, description, image, imageAlt, tags = [], urls, status, slug } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';
---

<div class="card group flex h-full flex-col overflow-hidden p-5">
  <div class="flex items-start justify-between mb-3">
    <div class="flex items-center space-x-2">
      <ProjectBadges type={type} status={status} />
    </div>
  </div>
  
  {image && (
    <div class="aspect-w-16 aspect-h-9 mb-4 overflow-hidden rounded-[1.25rem] bg-sage-100/70">
      <img 
        src={`${baseUrl}${image.replace(/^\//, '')}`} 
        alt={imageAlt || title}
        class="w-full h-32 object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  
  <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-sage-600 transition-colors duration-200">
    <a href={`${baseUrl}projects/${slug}/`}>{title}</a>
  </h3>
  
  <p class="mb-4 grow text-sm leading-relaxed text-gray-600">
    {description}
  </p>
  
  {tags && tags.length > 0 && (
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.slice(0, 3).map(tag => (
        <span class="tag text-xs px-2 py-1">{tag}</span>
      ))}
      {tags.length > 3 && (
        <span class="tag text-xs px-2 py-1">+{tags.length - 3}</span>
      )}
    </div>
  )}
  
  <div class="mt-auto flex flex-wrap gap-3 border-t border-sage-200/80 pt-4">
    <ProjectLinks urls={urls} size="sm" />
  </div>
</div>
