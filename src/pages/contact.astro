---
import BaseLayout from '../layouts/BaseLayout.astro';

// Formspree form endpoint. The form ID is public and safe to commit: it does not reveal
// the destination email address. See .agents/instructions/contact-form.md for the dashboard settings.
const FORMSPREE_ENDPOINT = 'https://formspree.io/f/myewbbgd';
---

<BaseLayout title="Contact - Moi">
  <div class="container-custom py-16">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">

      <!-- Left Info Side -->
      <div class="surface-soft relative overflow-hidden p-8">
        <svg class="page-sketch right-4 top-4 hidden h-20 w-24 md:block" viewBox="0 0 120 100" fill="none" aria-hidden="true">
          <path d="M16 26H104V74H16V26Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          <path d="M18 28L60 56L102 28" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <h1 class="text-4xl font-bold text-gray-900 mb-6">Get in Touch</h1>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Whether you want to discuss a research collaboration, ask a question about coding, or schedule a climbing session, I'd love to hear from you.
        </p>

        <div class="space-y-4 text-gray-600">
          <p>Please use the contact form on this page to send your message.</p>
        </div>
      </div>

      <!-- Right Form Side -->
      <div class="surface-card p-8">
        <form id="contact-form" action={FORMSPREE_ENDPOINT} method="POST" class="space-y-6">
          <input type="hidden" name="_subject" value="New message from c-est-moi.com" />
          <!-- Honeypot: hidden from people, bots fill it in and Formspree silently drops the submission -->
          <p class="hidden" aria-hidden="true">
            <label>
              Don’t fill this out if you're human:
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </label>
          </p>

          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full rounded-2xl border border-sage-200 bg-white/70 px-4 py-3 outline-hidden transition-colors focus:border-sage-600 focus:ring-sage-600" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="email" name="email" required class="w-full rounded-2xl border border-sage-200 bg-white/70 px-4 py-3 outline-hidden transition-colors focus:border-sage-600 focus:ring-sage-600" />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
            <textarea id="message" name="message" rows="4" required class="w-full rounded-3xl border border-sage-200 bg-white/70 px-4 py-3 outline-hidden transition-colors focus:border-sage-600 focus:ring-sage-600"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60">
            Send Message
          </button>

          <p id="form-status" role="status" aria-live="polite" class="hidden rounded-2xl px-4 py-3 text-sm"></p>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  const SUCCESS_CLASSES = ['bg-sage-100', 'text-sage-800'];
  const ERROR_CLASSES = ['bg-red-50', 'text-red-700'];
  const FALLBACK_ERROR = 'Sorry, something went wrong. Please try again later.';

  function showStatus(message: string, kind: 'success' | 'error') {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', ...SUCCESS_CLASSES, ...ERROR_CLASSES);
    status.classList.add(...(kind === 'success' ? SUCCESS_CLASSES : ERROR_CLASSES));
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!button) return;

    const originalLabel = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';
    status?.classList.add('hidden');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.reset();
        showStatus("Thanks, your message has been sent. I'll get back to you soon.", 'success');
      } else {
        const data = await response.json().catch(() => null);
        const errors: { message?: string }[] = Array.isArray(data?.errors) ? data.errors : [];
        const message = errors.map((error) => error.message).filter(Boolean).join(' ');
        showStatus(message || FALLBACK_ERROR, 'error');
      }
    } catch {
      showStatus(FALLBACK_ERROR, 'error');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>
