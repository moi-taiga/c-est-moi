---
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL;
const contactUrl = basePath.endsWith('/') ? `${basePath}contact/` : `${basePath}/contact/`;
---

<BaseLayout title="Contact - Moi">
  <div class="container-custom py-16">
    <div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-12">
      
      <!-- Left Info Side -->
      <div class="surface-soft relative overflow-hidden p-8">
        <svg class="page-sketch right-4 top-4 hidden h-20 w-24 md:block" viewBox="0 0 120 100" fill="none" aria-hidden="true">
          <path d="M16 26H104V74H16V26Z" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
          <path d="M18 28L60 56L102 28" stroke="currentColor" stroke-width="3" stroke-linejoin="round" />
        </svg>
        <h1 class="text-4xl font-bold text-gray-900 mb-6">Get in Touch</h1>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Whether you want to discuss a research collaboration, ask a question about coding, or schedule a climbing session, I'd love to hear from you.
        </p>

        <div class="space-y-4 text-gray-600">
          <p>Please use the contact form on this page to send your message.</p>
        </div>
      </div>
      
      <!-- Right Form Side -->
      <div class="surface-card p-8">
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action={contactUrl} class="space-y-6">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden" aria-hidden="true">
            <label>
              Don’t fill this out if you're human:
              <input name="bot-field" tabindex="-1" autocomplete="off" />
            </label>
          </p>
          
          <div>
            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full rounded-2xl border border-sage-200 bg-white/70 px-4 py-3 outline-none transition-colors focus:border-tekhelet focus:ring-tekhelet" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="email" name="email" required class="w-full rounded-2xl border border-sage-200 bg-white/70 px-4 py-3 outline-none transition-colors focus:border-tekhelet focus:ring-tekhelet" />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message</label>
            <textarea id="message" name="message" rows="4" required class="w-full rounded-[1.5rem] border border-sage-200 bg-white/70 px-4 py-3 outline-none transition-colors focus:border-tekhelet focus:ring-tekhelet"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">
            Send Message
          </button>
        </form>
      </div>

    </div>
  </div>
</BaseLayout>
