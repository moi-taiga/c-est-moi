---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Projects - Moi">
  <div class="container-custom py-16">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Projects</h1>
    <p class="text-xl text-gray-600 mb-12 max-w-2xl">
      Here is a selection of tools, resources, and apps I've built or contributed to.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <ProjectCard 
          title={project.data.title}
          type={project.data.type}
          description={project.data.description}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          urls={project.data.urls}
          tags={project.data.tags}
          status={project.data.status}
          slug={project.slug}
        />
      ))}
    </div>
  </div>
</BaseLayout>
