---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
---

<BaseLayout title="Projects - Moi">
  <div class="container-custom py-16">
    <div class="surface-soft relative mb-12 overflow-hidden px-8 py-10 md:px-10">
      <svg class="page-sketch right-6 top-6 hidden h-24 w-32 md:block" viewBox="0 0 140 100" fill="none" aria-hidden="true">
        <path d="M18 76L48 44L74 58L118 20" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M18 28H48M18 44H62M18 60H36" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
        <circle cx="48" cy="44" r="4" fill="currentColor" />
        <circle cx="74" cy="58" r="4" fill="currentColor" />
        <circle cx="118" cy="20" r="4" fill="currentColor" />
      </svg>
      <h1 class="mb-4 text-4xl font-bold text-gray-900">Projects</h1>
      <p class="max-w-2xl text-xl text-gray-600">
        Here is a selection of tools, resources, and apps I've built or contributed to.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <ProjectCard 
          title={project.data.title}
          type={project.data.type}
          description={project.data.description}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          urls={project.data.urls}
          tags={project.data.tags}
          status={project.data.status}
          slug={project.slug}
        />
      ))}
    </div>
  </div>
</BaseLayout>
