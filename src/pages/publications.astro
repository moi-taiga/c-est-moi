---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';

const publications = (await getCollection('publications'))
  .sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Publications - Moi">
  <div class="bg-gray-50 py-12 border-b border-gray-200">
    <div class="container-custom">
      <div class="max-w-3xl">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Publications</h1>
        <p class="text-xl text-gray-600">
          A collection of my academic work, research papers, and conference proceedings.
        </p>
      </div>
    </div>
  </div>
  
  <section class="py-16">
    <div class="container-custom">
      <div class="max-w-4xl space-y-8">
        {publications.length === 0 ? (
          <p class="text-gray-500">No publications available right now.</p>
        ) : (
          publications.map((pub) => (
            <div class="publication-item bg-white p-6 rounded-xl shadow-sm border border-gray-100 flex flex-col sm:flex-row gap-4">
              <div class="flex-shrink-0 text-center sm:text-left sm:w-20">
                <span class="text-2xl font-bold text-indigo-600/20">{pub.data.year}</span>
              </div>
              <div class="flex-grow">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                  {pub.data.url ? (
                    <a href={pub.data.url} target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 transition-colors">
                      {pub.data.title}
                    </a>
                  ) : (
                    pub.data.title
                  )}
                  {pub.data.featured && (
                    <span class="inline-block ml-2 px-2 py-1 text-xs font-semibold bg-indigo-100 text-indigo-800 rounded-full align-middle">
                      Featured
                    </span>
                  )}
                </h3>
                
                <p class="text-gray-700 mb-2">
                  {pub.data.authors.map((author, i) => (
                    <span class={author.includes('Moi') ? "font-semibold text-indigo-700" : ""}>
                      {author}{i < pub.data.authors.length - 1 ? ', ' : ''}
                    </span>
                  ))}
                </p>
                
                <div class="text-sm text-gray-600 mb-4 italic">
                  {pub.data.journal}
                </div>
                
                {pub.data.abstract && (
                  <p class="text-sm text-gray-600 mb-4 leading-relaxed line-clamp-3 hover:line-clamp-none cursor-pointer group" title="Click to expand/collapse">
                    {pub.data.abstract}
                    <span class="text-indigo-500 group-hover:hidden ml-1">(more)</span>
                  </p>
                )}
                
                <div class="flex flex-wrap gap-3 mt-4">
                  {pub.data.doi && (
                    <a 
                      href={`https://doi.org/${pub.data.doi}`} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="inline-flex items-center space-x-1 text-sm font-medium text-indigo-600 hover:text-indigo-800 bg-indigo-50 px-3 py-1 rounded"
                    >
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 21.5c-5.238 0-9.5-4.262-9.5-9.5S6.762 2.5 12 2.5 21.5 6.762 21.5 12 17.238 21.5 12 21.5zm1.5-12.75v5h-3v-5h3zm0-3.5v2h-3v-2h3z"/></svg>
                      <span>DOI</span>
                    </a>
                  )}
                  {pub.data.openAccessPdf && (
                    <a 
                      href={pub.data.openAccessPdf} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="inline-flex items-center space-x-1 text-sm font-medium text-green-700 hover:text-green-900 bg-green-50 px-3 py-1 rounded"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                      <span>PDF</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))
        )}
      </div>
    </div>
  </section>
</BaseLayout>
