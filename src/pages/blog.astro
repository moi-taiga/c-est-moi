---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';
---

<BaseLayout title="Blog - Moi">
  <div class="container-custom py-16">
    <div class="max-w-4xl mx-auto">
      <div class="surface-soft relative mb-12 overflow-hidden px-8 py-10 md:px-10">
        <svg class="page-sketch right-6 top-6 hidden h-24 w-28 md:block" viewBox="0 0 120 100" fill="none" aria-hidden="true">
          <path d="M20 24H80M20 42H96M20 60H72M20 78H88" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
          <path d="M84 18L100 32L84 46" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <h1 class="mb-4 text-4xl font-bold text-gray-900">Blog</h1>
        <p class="max-w-2xl text-xl text-gray-600">
          Thoughts on coding, data science, climbing, and academia.
        </p>
      </div>

      {posts.length === 0 ? (
        <div class="surface-card p-8 text-center text-gray-500">
          No posts yet. Check back soon!
        </div>
      ) : (
        <div class="space-y-6 flex flex-col items-stretch">
          {posts.map((post) => (
            <a href={`${baseUrl}blog/${post.slug}/`} class="block group">
              <div class="card p-6">
                <div class="text-sm text-gray-500 mb-2">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-us', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                </div>
                <h3 class="mb-2 text-2xl font-bold text-gray-900 transition-colors group-hover:text-sage-600">
                  {post.data.title}
                </h3>
                <p class="text-gray-600">{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mt-4 flex gap-2">
                    {post.data.tags.map(tag => (
                      <span class="tag px-2 py-1 text-xs">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
