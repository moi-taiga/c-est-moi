---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';
---

<BaseLayout title="Blog - Moi">
  <div class="container-custom py-16">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Blog</h1>
      <p class="text-xl text-gray-600 mb-12 max-w-2xl">
        Thoughts on coding, data science, climbing, and academia.
      </p>

      {posts.length === 0 ? (
        <div class="bg-gray-50 border border-gray-200 rounded-lg p-8 text-center text-gray-500">
          No posts yet. Check back soon!
        </div>
      ) : (
        <div class="space-y-6 flex flex-col items-stretch">
          {posts.map((post) => (
            <a href={`${baseUrl}blog/${post.slug}/`} class="block group">
              <div class="p-6 bg-white border border-gray-100 rounded-xl shadow-sm group-hover:shadow-md transition-shadow">
                <div class="text-sm text-gray-500 mb-2">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString('en-us', {
                      year: 'numeric', month: 'long', day: 'numeric'
                    })}
                  </time>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2 group-hover:text-indigo-600 transition-colors">
                  {post.data.title}
                </h3>
                <p class="text-gray-600">{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mt-4 flex gap-2">
                    {post.data.tags.map(tag => (
                      <span class="text-xs bg-indigo-50 text-indigo-700 px-2 py-1 rounded">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
