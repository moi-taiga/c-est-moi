---
import BaseLayout from '../layouts/BaseLayout.astro';

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';
---

<BaseLayout title="About - Moi">
  <div class="container-custom py-16">
    <div class="max-w-4xl mx-auto bg-white p-8 md:p-12 rounded-xl shadow-sm border border-gray-100">
      <h1 class="text-4xl font-bold text-gray-900 mb-6">About Me</h1>
      
      <div class="prose prose-lg text-gray-700 max-w-none">
        <p>I'm Moi, a PhD student, coder, and climbing instructor.</p>
        
        <h2>Academic Background</h2>
        <p>I focus on data-driven biology and computational methods. My research involves analyzing complex biological datasets and building tools to make sense of them.</p>

        <h2>Coding</h2>
        <p>I build web apps, data pipelines, and visualization tools. I'm passionate about open-source software and making research more accessible.</p>
        
        <h2>Climbing</h2>
        <p>When I'm not behind a screen, you'll likely find me at the local climbing gym or crag. I instruct climbers of all levels and love the problem-solving nature of the sport.</p>
      </div>
    </div>
  </div>
</BaseLayout>
