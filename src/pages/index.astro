---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';

const projects = await getCollection('projects');

// Optional sorting if we add order/dates later
const featuredProjects = projects.slice(0, 3);
---

<BaseLayout title="Moi - PhD Student, Coder, Climbing Instructor">
  <HeroSection />
  
  <!-- Brief Intro Section -->
  <section class="py-20">
    <div class="container-custom">
      <div class="surface-soft mx-auto max-w-4xl px-8 py-12 text-center md:px-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">Bridging Code and Verticals</h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Welcome to my digital home. I spend my days developing software and models for biological research, and my evenings sharing my passion for climbing. Take a look around to see my academic path, my coding projects, and my journey on the wall.
        </p>
        <a href={`${baseUrl}contact/`}
           class="inline-flex cursor-pointer select-none items-center justify-center rounded-full border-2 border-sage-700 bg-sage-700 px-10 py-3 text-sm font-semibold tracking-wide text-white shadow-lg transition-all duration-200 hover:-translate-y-1 hover:border-sage-800 hover:bg-sage-800 hover:shadow-xl active:translate-y-0">
          Let's Connect
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-20">
    <div class="container-custom">
      <div class="surface-card relative mx-auto max-w-4xl overflow-hidden px-8 py-12 md:px-12">
        <h2 class="mb-6 text-center text-3xl font-bold text-gray-900">About Me</h2>
        
        <div class="prose prose-lg max-w-none text-gray-700">
          <p>I'm Moi, a PhD student, coder, and climbing instructor.</p>
          
          <h3>Academic Background</h3>
          <p>I focus on data-driven biology and computational methods. My research involves analyzing complex biological datasets and building tools to make sense of them.</p>

          <h3>Coding</h3>
          <p>I build web apps, data pipelines, and visualization tools. I'm passionate about open-source software and making research more accessible.</p>
          
          <h3>Climbing</h3>
          <p>When I'm not behind a screen, you'll likely find me at the local climbing gym or crag. I instruct climbers of all levels and love the problem-solving nature of the sport.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Teaser -->
  {featuredProjects.length > 0 && (
    <section class="py-20">
      <div class="container-custom">
        <div class="flex justify-between items-end mb-12">
          <div>
            <h2 class="text-3xl font-bold text-gray-900 mb-2">Recent Projects</h2>
            <p class="text-gray-600">Some of my recent coding and data science work.</p>
          </div>
          <a href={`${baseUrl}projects/`} class="accent-link">View All →</a>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {featuredProjects.map((project) => (
            <ProjectCard 
              title={project.data.title}
              type={project.data.type}
              description={project.data.description}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              urls={project.data.urls}
              tags={project.data.tags}
              status={project.data.status}
              slug={project.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
