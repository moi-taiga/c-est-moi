---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectBadges from '../../components/ProjectBadges.astro';
import ProjectLinks from '../../components/ProjectLinks.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, type, description, image, imageAlt, tags, urls, status, role } = project.data;

const basePath = import.meta.env.BASE_URL;
const baseUrl = basePath.endsWith('/') ? basePath : basePath + '/';
const hasLinks = Boolean(urls && Object.values(urls).some(Boolean));
---

<BaseLayout title={`${title} - Moi`} description={description}>
  <div class="container-custom py-16">
    <div class="max-w-3xl mx-auto">
      <!-- Back link -->
      <a href={`${baseUrl}projects/`} class="accent-link mb-8 inline-flex items-center text-sm">
        ← Back to Projects
      </a>

      <!-- Header -->
      <div class="surface-soft mb-8 px-8 py-8">
        <div class="flex items-center gap-3 mb-4">
          <ProjectBadges type={type} status={status} />
        </div>
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{title}</h1>
        <p class="text-xl text-gray-600">{description}</p>
        {role && (
          <p class="mt-4 text-sm font-medium text-sage-700">My role: {role}</p>
        )}
      </div>

      <!-- Image -->
      {image && (
        <div class="surface-card mb-8 overflow-hidden bg-sage-100/50">
          <img
            src={`${baseUrl}${image.replace(/^\//, '')}`}
            alt={imageAlt || title}
            class="w-full object-cover"
          />
        </div>
      )}

      <!-- Tags -->
      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-8">
          {tags.map((tag) => (
            <span class="tag px-2 py-1 text-xs">{tag}</span>
          ))}
        </div>
      )}

      <!-- Links -->
      {hasLinks && (
        <div class="mb-10 flex flex-wrap gap-4 border-b border-sage-200 pb-8">
          <ProjectLinks urls={urls} size="md" />
        </div>
      )}

      <!-- Content -->
      <div class="prose prose-gray max-w-none">
        <Content />
      </div>
    </div>
  </div>
</BaseLayout>
